{
  "name": "minecraft-server-manager",
  "version": "2.0.0",
  "description": "Real-time Minecraft Server Manager",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --out-path dist"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "assets": [
      "public/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/archiver/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "archiver": "^6.0.1",
    "chokidar": "^3.6.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  }
}
